# Copia este archivo como `.env` y complétalo. `.env` nunca se sube al repositorio.

# App (públicas: van dentro de la app; los permisos los pone RLS en la base de datos)
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo para esta computadora (migraciones, Edge Functions y primer administrador). Nunca en la app.
# Supabase → botón Connect → Session pooler (puerto 5432), con la contraseña de la base de datos.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Supabase → Account → Access Tokens
SUPABASE_ACCESS_TOKEN=sbp_...

# Primer administrador (lo crea `npm run db:seed-admin`)
ADMIN_CEDULA=
ADMIN_EMAIL=
